# ============================================================================
# professor / backend
# ============================================================================
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- MongoDB (obrigatório) ---------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=sapiens_professor

# --- JWT (obrigatório) -------------------------------------------------------
# Assina os tokens de acesso. Em produção, mínimo 32 caracteres.
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- CORS / frontend (obrigatório em produção) ------------------------------
FRONTEND_URL=http://localhost:3002
# CORS_ORIGINS=https://professor.exemplo.app

# --- Cookies -----------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.exemplo.app

# --- Semente do administrador ------------------------------------------------
# Cria o admin no primeiro boot, se ainda não existir.
# Em produção: mínimo 12 caracteres; senhas de exemplo são recusadas.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Dados de demonstração --------------------------------------------------
# Turmas e alunos fictícios. Recusado em produção.
SEED_DEMO_DATA=false
