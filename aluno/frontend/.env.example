# ============================================================================
# aluno / frontend
# ============================================================================
# Variáveis REACT_APP_* são EMBUTIDAS NO BUNDLE em tempo de build e ficam
# publicamente legíveis. Nunca coloque segredo aqui.

PORT=3000
REACT_APP_BACKEND_URL=http://localhost:8001
GENERATE_SOURCEMAP=false

# --- Firebase Authentication (login com Google) ---------------------------
# Estes NÃO são segredos: a apiKey do Firebase Web é um identificador público
# de projeto. Quem protege o projeto são os domínios autorizados no Identity
# Platform, não o sigilo dela. O Google a publica no próprio snippet de setup.
# Valores em Firebase Console -> Configurações do projeto -> Seus apps (Web).
# Se ficarem vazias, o botão "Continuar com Google" simplesmente não aparece.
REACT_APP_FIREBASE_API_KEY=
# O DOMÍNIO DO HANDLER DE AUTENTICAÇÃO — e ele deve ser o SEU, não o do Firebase.
#
# Com o padrão (`<projeto>.firebaseapp.com`), `signInWithPopup` abre o handler
# noutro site e a devolução depende de armazenamento de terceiro: o Chrome
# particiona, o navegador embutido do Instagram bloqueia, e a janela fica
# branca sem lançar erro nenhum. Apontando para o domínio do próprio app, o
# handler vira mesma origem — `public/_worker.js` é quem o serve.
#
# Se mudar aqui, o domínio precisa estar em `authorizedDomains` no Firebase.
REACT_APP_FIREBASE_AUTH_DOMAIN=sapiens-aluno.pages.dev
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=

# --- Meta Pixel (Facebook/Instagram Ads) ----------------------------------
# O ID do pixel do Gerenciador de Eventos. Não é segredo — ele vai no HTML de
# qualquer site que o use e é lido por qualquer visitante.
#
# PREENCHER ESTA VARIÁVEL É O ATO QUE LIGA O RASTREIO DE TERCEIRO. Vazia,
# `lib/rastreio.js` não injeta script nenhum, não faz requisição e não grava
# cookie. Com ela, o `fbevents.js` é injetado depois da primeira pintura e
# SOMENTE nas landings de anúncio (`/ads/*`) — nunca dentro do app do aluno.
# Ver `Cerebro/produto/landings-de-anuncio.md`.
REACT_APP_META_PIXEL_ID=
