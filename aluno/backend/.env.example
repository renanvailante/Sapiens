# ============================================================================
# aluno / backend
# ============================================================================
APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- MongoDB (obrigatório) ---------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=sapiens_aluno

# --- CORS (obrigatório em produção) -----------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Cookie de sessão --------------------------------------------------------
# Frontend e backend em domínios diferentes sobre HTTPS exigem o par
# Secure + SameSite=None. Em http://localhost o navegador DESCARTA esse cookie
# em silêncio — por isso o default de desenvolvimento é lax/insecure.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.exemplo.app        # só para compartilhar entre subdomínios
SESSION_TTL_DAYS=7

# --- Gemini API (obrigatório em produção) -----------------------------------
# OCR do cartão-resposta e narrativa diagnóstica do simulado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_VISION_MODEL=gemini-3-flash-preview

# --- Firebase / Firestore (obrigatório em produção) -------------------------
# Onde os eventos de behavior (contrato 1.1) são gravados.
FIREBASE_SERVICE_ACCOUNT_PATH=
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
# Sincroniza Firestore -> questoes_public sozinho, a cada N segundos (além do
# botão manual "Sincronizar Firestore" em /admin, que continua existindo).
# FIRESTORE_AUTO_SYNC_SECONDS=300

# --- Figuras de questão (opcional) ------------------------------------------
# /api/exam-images/{item_id} busca os bytes no pipeline (que continua sendo o
# único a tocar o storage binário) servidor-a-servidor. Sem isto, o endpoint
# responde 503 — o resto do app funciona normalmente.
# PIPELINE_URL=http://localhost:8000
# PIPELINE_API_KEY=

# --- Corpus canônico --------------------------------------------------------
# Só quando os apps são publicados separadamente e pipeline/docs/ não acompanha
# o artefato do aluno.
# SAPIENS_ONTOLOGY_PATH=/app/docs/ontology/ontology_v1.4.json
# SAPIENS_CONTRACTS_PATH=/app/contracts

# --- Mercado Pago / loja de Sparks (obrigatório em produção) ----------------
# Compra avulsa de Sparks (Payment Brick) + recarga automática por assinatura
# (Preapproval, calendário). MERCADOPAGO_WEBHOOK_SECRET só existe depois de
# cadastrar a URL .../api/sparks/webhook em Webhooks > Configurar
# notificações no painel da aplicação — não é o mesmo par de token/public key.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Administração (obrigatório em produção) --------------------------------
ADMIN_EMAILS=

# --- Dados de demonstração --------------------------------------------------
SEED_DEMO_DATA=false

# --- Saneamento do corpus (auditoria 2026-08-26) -------------------------
# FIRESTORE_AUTO_SYNC_SECONDS=0 DESLIGA o espelhamento automatico
# Firestore -> questoes_public. Usado enquanto os quatro stores estao sendo
# corrigidos: a reconstrucao periodica desfaria correcao ainda nao espelhada.
# Valor <= 0 desliga; ausente ou > 0 mantem o comportamento normal (300s).
# FIRESTORE_AUTO_SYNC_SECONDS=0
#
# Cerco de circulacao: caminho do bloqueados.json emitido por
# pipeline/scripts/audit_corpus.py. Itens BLOQUEADOS pela auditoria nao sao
# servidos ao aluno e respostas a eles sao recusadas com 409. Filtro de
# leitura, sem escrita em banco — remover a variavel desliga o cerco.
# SANEAMENTO_BLOQUEADOS_PATH=/caminho/para/.saneamento/bloqueados.json
# SANEAMENTO_BLOQUEADOS=ITEM-...-Q001,ITEM-...-Q002
