# ============================================================================
# pipeline / backend — anotador cognitivo
# ============================================================================
# Copie para .env e preencha. NUNCA versione o .env preenchido.
# Em APP_ENV=production o processo RECUSA subir se algo obrigatório faltar.

APP_ENV=development                 # development | production
LOG_LEVEL=INFO

# --- MongoDB (obrigatório) ---------------------------------------------------
# Redundância deliberada da arquitetura: NÃO migrar para Firestore.
MONGO_URL=mongodb://localhost:27017
DB_NAME=sapiens_pipeline

# --- Segredo de acesso (obrigatório) ----------------------------------------
# Protege TODAS as rotas /api do pipeline, via header X-API-Key.
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# ATENÇÃO: nunca coloque este valor num .env de frontend — o Create React App
# o embutiria no bundle público. Ver pipeline/frontend/craco.config.js.
PIPELINE_API_KEY=

# --- Gemini API (obrigatório) ------------------------------------------------
# Anotação cognitiva, manifesto de caderno e importação de ontologia por PDF.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# MINIMAL | LOW | MEDIUM | HIGH. gemini-3-flash-preview vem com thinking
# ligado por padrão em HIGH — tokens de "thinking" são cobrados como saída
# ($3,00/1M) e foram a causa mais provável de um lote custar ~14x o esperado
# (auditoria de 2026-08-22). Vazio/ausente usa o padrão do código
# (`cognitive_engine.DEFAULT_THINKING_LEVEL`); ver
# auditoria/AUDITORIA-OTIMIZACAO-CUSTO-GEMINI.md para o resultado do teste
# controlado que escolheu esse padrão. Use UNSET/DEFAULT/NONE para voltar ao
# comportamento nativo do modelo (HIGH, sem limite).
# ATENÇÃO: só é usado quando GEMINI_THINKING_STRATEGY=FIXED (ver abaixo) ou
# quando o chamador passa thinking_level explícito. No padrão ADAPTIVE, quem
# controla os níveis usados é o par GEMINI_THINKING_LEVEL_LOW/_ESCALATED.
GEMINI_THINKING_LEVEL=

# ADAPTIVE (padrão) | FIXED. 2ª rodada da auditoria de custo (2026-08-22) —
# ver auditoria/AUDITORIA-OTIMIZACAO-CUSTO-GEMINI-2.md. ADAPTIVE tenta cada
# questão em GEMINI_THINKING_LEVEL_LOW (barato); se a validação estrutural
# reprovar a saída, reexecuta UMA única vez em GEMINI_THINKING_LEVEL_ESCALATED
# — nunca mais que 2 chamadas por questão. Simulação com dados reais já
# pagos (mesmas 8 questões sintéticas do teste da 1ª rodada) projetou custo
# ~80% menor que MEDIUM fixo, com validade estrutural igual (8/8). Uma
# escolha explícita de thinking_level (ex.: o seletor da tela do caderno)
# sempre desliga o modo adaptativo para aquela chamada, independentemente
# deste valor. FIXED volta ao comportamento de nível único (GEMINI_THINKING_LEVEL).
GEMINI_THINKING_STRATEGY=ADAPTIVE
# MINIMAL | LOW | MEDIUM | HIGH — só usados em modo ADAPTIVE.
GEMINI_THINKING_LEVEL_LOW=LOW
GEMINI_THINKING_LEVEL_ESCALATED=MEDIUM

# --- CORS (obrigatório em produção) -----------------------------------------
# Origens exatas do frontend, separadas por vírgula. '*' é recusado: é
# incompatível com credenciais e deixaria qualquer site ler respostas suas.
CORS_ORIGINS=http://localhost:3001

# --- Firebase / Firestore ---------------------------------------------------
# 'admin' = espelho real; 'mock' = em memória (só desenvolvimento).
FIRESTORE_MODE=mock
FIRESTORE_COLLECTION=itens
# Caminho do arquivo OU o JSON inteiro (útil em PaaS que só aceita variável):
GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Armazenamento de artefatos ---------------------------------------------
# 'local' grava em disco — INVÁLIDO em produção: o disco de um container é
# efêmero e os PDFs originais somem no primeiro redeploy.
STORAGE_MODE=local
# STORAGE_ROOT=/caminho/absoluto
# FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
APP_NAME=sapiens-cognitive

# --- Limites de upload ------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_FILES_POR_REQUISICAO=20

# --- Dados de demonstração --------------------------------------------------
# Recusado em produção.
SEED_DEMO_DATA=false
