# ============================================================================
# pipeline / frontend
# ============================================================================
# Variáveis REACT_APP_* são EMBUTIDAS NO BUNDLE em tempo de build e ficam
# publicamente legíveis. Nunca coloque segredo aqui.

PORT=3001
REACT_APP_BACKEND_URL=http://localhost:8001
GENERATE_SOURCEMAP=false

# --- ATENÇÃO ----------------------------------------------------------------
# REACT_APP_PIPELINE_API_KEY é o segredo que protege todo o backend do
# pipeline. Colocá-lo aqui o publica no bundle. A build de produção é RECUSADA
# se ele estiver definido (ver craco.config.js).
#
# O painel do pipeline é ferramenta INTERNA: rode-o localmente contra o backend
# publicado, ou por trás da autenticação da plataforma de hosting.
# REACT_APP_PIPELINE_API_KEY=
